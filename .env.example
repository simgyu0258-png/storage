NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_this_to_long_random_string

# Supabase - Transaction Pooler (앱 런타임용, 포트 6543)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase - Direct Connection (마이그레이션용, 포트 5432)
DIRECT_URL="postgresql://postgres.[ref]:[password]@[ref].supabase.co:5432/postgres"


